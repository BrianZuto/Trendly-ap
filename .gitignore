# Complementa backend/.gitignore y frontend/.gitignore (generados por Spring Initializr y Vite).

# --- Java / Maven ---
target/
*.class
*.log
hs_err_pid*
# El wrapper de Maven sí se versiona (si existe el .jar)
!.mvn/wrapper/maven-wrapper.jar

# --- Node ---
node_modules/
dist/
coverage/
npm-debug.log*

# --- Expo / React Native (mobile/, Sprint 4) ---
.expo/
web-build/

# --- IDEs ---
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Entorno y secretos ---
.env
.env.*
!.env.example
